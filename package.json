{
  "name": "portfolio-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:sa": "sanity dev",
    "start": "astro dev",
    "prebuild": "astro check",
    "build": "astro build",
    "deploy:sa": "sanity schema deploy --manifest-dir ./public/studio/static",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typegen": "$npm_execpath typegen:sa && $npm_execpath typegen:cf",
    "typegen:cf": "wrangler types",
    "typegen:sa": "sanity schema extract --force && sanity typegen generate"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "14.4.0",
    "@astrojs/react": "7.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/hepta-slab": "^5.3.0",
    "@imikailoby/lastfm-ts": "2.0.3",
    "@oscarrc/crust": "^0.2.1",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^8.9.0",
    "@sanity/code-input": "^7.3.12",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.4.9",
    "@sanity/vision": "^6.19.0",
    "@sanity/visual-editing": "^6.1.3",
    "@sanity/webhook": "^4.0.4",
    "@shikijs/colorized-brackets": "^4.5.0",
    "@shikijs/transformers": "^4.5.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tabler/icons-astro": "^3.49.0",
    "@tabler/icons-react": "3.49.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^1.1.0",
    "astro": "7.4.0",
    "astro-portabletext": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dayjs": "^1.11.23",
    "groq": "^6.19.0",
    "js-confetti": "^0.13.1",
    "posthog-js": "^1.438.12",
    "posthog-node": "^5.56.2",
    "psn-api": "^2.18.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remeda": "^2.52.0",
    "sanity": "^6.19.0",
    "sanity-plugin-webhooks-trigger": "^1.0.1",
    "styled-components": "^6.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.12",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@12.14.0"
}
