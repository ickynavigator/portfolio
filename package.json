{
  "name": "portfolio-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:sa": "sanity dev",
    "start": "astro dev",
    "prebuild": "astro check",
    "build": "astro build",
    "deploy:sa": "sanity schema deploy --manifest-dir ./public/studio/static",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "knip": "knip --cache",
    "typegen": "$npm_execpath typegen:sa && $npm_execpath typegen:cf",
    "typegen:cf": "wrangler types",
    "typegen:sa": "sanity schema extract --force && sanity typegen generate"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/react": "7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.6",
    "@imikailoby/lastfm-ts": "2.0.3",
    "@oscarrc/crust": "^0.2.1",
    "@sanity/astro": "^4.1.1",
    "@sanity/client": "^8.17.0",
    "@sanity/code-input": "^7.3.16",
    "@sanity/icons": "^5.4.0",
    "@sanity/ui": "^4.4.12",
    "@sanity/vision": "^6.25.0",
    "@sanity/webhook": "^4.0.4",
    "@shikijs/colorized-brackets": "^4.6.0",
    "@shikijs/transformers": "^4.6.0",
    "@tabler/icons-astro": "^3.53.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/charts": "^1.5.0",
    "astro": "7.4.13",
    "astro-portabletext": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dayjs": "^1.11.23",
    "groq": "^6.25.0",
    "js-confetti": "^0.13.1",
    "posthog-js": "^1.455.2",
    "posthog-node": "^6.1.0",
    "psn-api": "^2.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remeda": "^2.62.4",
    "sanity": "^6.25.0",
    "sanity-plugin-webhooks-trigger": "^1.1.0",
    "styled-components": "^6.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "1.11.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@sanity-labs/eslint-plugin": "^1.1.9",
    "@shadcn/lint": "^0.2.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.48.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "wrangler": "^4.168.0"
  },
  "packageManager": "pnpm@12.21.0"
}
