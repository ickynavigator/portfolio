{
  "name": "portfolio-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:sa": "sanity dev",
    "start": "astro dev",
    "prebuild": "astro check",
    "build": "astro build",
    "deploy:sa": "sanity schema deploy --manifest-dir ./public/studio/static",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typegen": "$npm_execpath typegen:sa && $npm_execpath typegen:cf",
    "typegen:cf": "wrangler types",
    "typegen:sa": "sanity schema extract --force && sanity typegen generate"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "https://pkg.pr.new/@astrojs/cloudflare@c5d88b7",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/hepta-slab": "^5.3.0",
    "@imikailoby/lastfm-ts": "2.0.3",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^8.6.1",
    "@sanity/code-input": "^7.3.8",
    "@sanity/icons": "^5.2.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.2.1",
    "@sanity/vision": "^6.13.1",
    "@shikijs/colorized-brackets": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@t3-oss/env-core": "^0.13.11",
    "@tabler/icons-astro": "^3.46.0",
    "@tabler/icons-react": "3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "astro-portabletext": "^1.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "dayjs": "^1.11.23",
    "groq": "^6.13.1",
    "lodash": "^4.18.1",
    "partysocket": "^1.3.0",
    "posthog-js": "^1.429.1",
    "posthog-node": "^5.51.8",
    "psn-api": "^2.18.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1",
    "remeda": "^2.48.0",
    "sanity": "^6.13.1",
    "sanity-plugin-webhooks-trigger": "^1.0.1",
    "sonner": "^2.0.8",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.11",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "partykit": "0.0.115",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.130.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.26.0"
}
