<div class="faded-edge overflow-hidden">
  <div
    class="marquee select-none w-full py-1"
    data-marquee-direction="horizontal"
    style={{ "--count": 1, "--slowdown": 10 }}
  >
    <div data-marquee-item style={{ "--index": 1 }} class="w-full">
      <p class="bg-linear-to-r from-green-300 via-blue-500 to-purple-600 bg-clip-text text-lg font-bold text-transparent">
        Happy Birthday To Me!
      </p>
    </div>
  </div>
</div>

<style>
  .faded-edge {
    --mask: linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0,
        rgba(0, 0, 0, 1) 5%,
        rgba(0, 0, 0, 1) 95%,
        rgba(0, 0, 0, 0) 100%
      )
      50% 100% / 100% 100% repeat-y;

    -webkit-mask: var(--mask);
    mask: var(--mask);
  }
</style>

<script>
  import JSConfetti from "js-confetti";

  const randomInRange = (min: number, max: number) =>
    Math.random() * (max - min) + min;

  const jsConfetti = new JSConfetti();

  const triggerConfetti = () => {
    const duration = 10 * 1000;
    const animationEnd = Date.now() + duration;

    const interval = setInterval(() => {
      const timeLeft = animationEnd - Date.now();

      if (timeLeft <= 0) {
        clearInterval(interval);
        return;
      }

      const confettiNumber = Math.ceil(5 * (timeLeft / duration));
      const { innerWidth, innerHeight } = window;
      const position = (min: number, max: number) => ({
        x: randomInRange(min, max) * innerWidth,
        y: Math.random() * innerHeight * 0.5,
      });

      void Promise.all([
        jsConfetti.addConfettiAtPosition({
          emojis: ["🎂"],
          emojiSize: 40,
          confettiNumber,
          confettiDispatchPosition: position(0.1, 0.3),
        }),
        jsConfetti.addConfettiAtPosition({
          emojis: ["🎂"],
          emojiSize: 40,
          confettiNumber,
          confettiDispatchPosition: position(0.7, 0.9),
        }),
        jsConfetti.addConfettiAtPosition({
          confettiNumber: 15,
          confettiDispatchPosition: position(0.4, 0.6),
        }),
      ]);
    }, 250);
  };

  triggerConfetti();
</script>
