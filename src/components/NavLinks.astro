---
import { IconMenu2 } from "@tabler/icons-astro";

import ThemeSwitcher from "~/components/ThemeSwitcher.astro";
---

<div>
  <div class="hidden items-center gap-4 md:flex">
    <slot />

    <slot name="search" />
    <ThemeSwitcher id="md" />
  </div>

  <div class="md:hidden">
    <button
      popovertarget="navigation-menu"
      aria-label="Open Navigation Menu"
      title="Open menu"
    >
      <IconMenu2 />
      <span class="sr-only">Toggle Menu</span>
    </button>

    <div popover id="navigation-menu" class="py-6">
      <div>
        <h1 class="text-center text-lg leading-none font-semibold tracking-tight">
          Obi Fortune
        </h1>
      </div>

      <div class="mt-16 flex flex-col items-center gap-10">
        <div class="flex flex-col items-center gap-4">
          <slot />
        </div>

        <div class="flex flex-col items-center gap-4">
          <slot name="search" />
          <ThemeSwitcher id="xs" />
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  @reference "../styles/globals.css";

  :root {
    --drawer-animation-duration: 500ms;
    --drawer-animation-timing: cubic-bezier(0.32, 0.72, 0, 1);
  }

  body:has(#navigation-menu:popover-open) {
    @apply overflow-hidden overscroll-contain;
  }

  @keyframes drawer-in {
    from {
      translate: 0 calc(100%);
    }
  }

  @keyframes drawer-backdrop-in {
    from {
      opacity: 0;
    }
  }

  #navigation-menu {
    @apply bg-background fixed inset-[unset] inset-x-2 bottom-2 z-50 h-auto max-h-[80vh] w-auto translate-y-[calc(100%+1rem)] overscroll-contain rounded-xl border;

    &,
    &::backdrop {
      transition:
        translate var(--drawer-animation-duration)
          var(--drawer-animation-timing),
        overlay var(--drawer-animation-duration) allow-discrete,
        display var(--drawer-animation-duration) allow-discrete;
    }

    &:popover-open {
      @apply translate-y-0;
      animation-name: drawer-in;

      &,
      &::backdrop {
        animation-timing-function: var(--drawer-animation-timing);
        animation-duration: var(--drawer-animation-duration);
      }

      &::backdrop {
        @apply opacity-100;
        animation-name: drawer-backdrop-in;
      }
    }

    &::backdrop {
      @apply bg-black/50 opacity-0;
    }
  }
</style>
