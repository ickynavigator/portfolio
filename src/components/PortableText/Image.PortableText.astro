---
import SanityImage from "~/components/SanityImage.astro";
import type { SanityImageValue } from "~/lib/sanity/types";

interface Props {
  node: {
    asset: SanityImageValue;
    alt: string;
  };
}

const { node } = Astro.props;
---

<SanityImage
  node={node}
  pictureProps={{
    class: "flex items-center justify-center",
  }}
/>
