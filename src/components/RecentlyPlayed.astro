---
import { getRecentlyPlayedTracks } from "~/lib/music";

const { recenttracks } = await getRecentlyPlayedTracks();
---

<ul
  class="marquee mt-4"
  data-marquee-direction="horizontal"
  data-marquee-pause-on-hover
  style={{ "--count": Math.max(recenttracks.track.length, 1) }}
>
  {recenttracks.track.map((track, index) => (
    <li
      data-marquee-item
      class="group relative aspect-square size-64 rounded-md bg-contain bg-center bg-no-repeat"
      style={{
        backgroundImage: `url(${track.image[track.image.length - 1]?.["#text"]})`,
        "--index": index + 1,
      }}
    >
      <a href={track.url} target="_blank" rel="noopener noreferrer">
        <div class="size-full p-4 transition not-group-hover:invisible group-hover:bg-black/70 group-hover:backdrop-blur-xs">
          {[
            ["Name", track.name],
            ["Artist", track.artist["#text"]],
            ["Album", track.album["#text"]],
          ].map(([title, value]) => (
            <div class="text-sm font-semibold text-white">
              {title}: {value}
            </div>
          ))}
        </div>
        <span class="sr-only">{track.name}</span>
      </a>
    </li>
  ))}
</ul>
