---
import { isImageWithAsset, SanityImage } from "@sanity/astro/image";
import type { HTMLAttributes } from "astro/types";

import type { SanityImageValue } from "~/lib/sanity/types";

interface Props extends Omit<HTMLAttributes<"img">, "height" | "width"> {
  node: {
    asset?: SanityImageValue;
    alt: string;
  };
  pictureProps?: HTMLAttributes<"picture">;
}

const { node, pictureProps, ...attrs } = Astro.props;

if (!isImageWithAsset(node)) return null;
---

<picture {...pictureProps}>
  <SanityImage {...attrs} src={node.asset} alt={node.alt} />
</picture>
