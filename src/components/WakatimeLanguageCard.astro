---
import { getWakatimeData, type WakatimeRange } from "~/lib/wakatime";

interface Props {
  range: WakatimeRange;
}

const { range } = Astro.props;

const { data, rangeLabel } = await getWakatimeData({ range: range });

const chartData = data.filter((lang) => lang.name !== "Other").slice(0, 6);

const stringifiedChartData = JSON.stringify(chartData);
---

<div class="w-full grow bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm">
  <div class="items-center pb-4 grid auto-rows-min grid-rows-[auto_auto] gap-2 px-6 [.border-b]:pb-6">
    <span class="leading-none font-semibold">Top Languages</span>
    <p class="text-muted-foreground text-sm capitalize">{rangeLabel}</p>
  </div>

  <div class="px-6">
    <custom-chart
      class="block w-full min-w-0"
      data-table={stringifiedChartData}
      data-label={`Top languages over period: ${rangeLabel}`}
    ></custom-chart>
  </div>
</div>

<script>
  import { ChartBase } from "~/lib/chart";
  import { wakatimeLanguageSchema } from "~/lib/wakatime";

  class CustomChart extends ChartBase<typeof wakatimeLanguageSchema> {
    constructor() {
      super({ schema: wakatimeLanguageSchema });
    }

    connectedCallback() {
      const data = this.getSchemaWithPreprocess().parse(this.dataset.table);

      this.mount({
        chartOptions: {
          data,
          xAxis: "total_seconds",
          yAxis: "name",
          getValue: (datum) => datum.total_seconds,
          formatText: (datum) => datum.text,
          getColor: (datum) => datum.color,
        },
        label: this.dataset.label ?? "Wakatime Languages",
        description: data
          .map((datum) => `${datum.name}: ${datum.text}`)
          .join(", "),
      });
    }
  }

  customElements.define("custom-chart", CustomChart);
</script>
