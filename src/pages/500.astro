---
import MainLayout from "~/layouts/MainLayout.astro";
import NavLayout from "~/layouts/NavLayout.astro";
import { captureServerException } from "~/lib/analytics/server";

// Rendered on demand so the real error reaches PostHog; a prerendered 500
// page runs once at build time with no error and never reports anything.
export const prerender = false;

interface Props {
  error: unknown;
}

const { error } = Astro.props;

captureServerException(error);
---

<MainLayout
  meta={{
    title: "500",
    description: "An Error Occured",
  }}
>
  <NavLayout>
    <div class="flex h-[50vh] flex-col items-center justify-center gap-7 px-20 text-center">
      <p class="text-9xl font-black">500</p>
      <h1 class="text-4xl font-black">Something bad just happened...</h1>
      <p class="text-muted-foreground">
        Our servers could not handle your request. Don't worry, our development
        team was already notified. Try refreshing the page.
      </p>
      <a href="/" class="hover-link">
        Or take me back to home page
      </a>
    </div>
  </NavLayout>
</MainLayout>
